digraph ParseTree {
 graph [ordering=out]; node [shape=circle];
subgraph cluster0 { style=invis;  n0_0 [label="S"]; {rank=same;n0_0;}}
subgraph cluster1 { style=invis;  n1_0 [label="a"]; n1_1 [label="A"]; n1_2 [label="a"]; {rank=same;n1_0;n1_1;n1_2;}}
subgraph cluster2 { style=invis;  n2_0 [label="a"]; n2_1 [label="b"]; n2_2 [label="B"]; n2_3 [label="b"]; n2_4 [label="a"]; {rank=same;n2_0;n2_1;n2_2;n2_3;n2_4;}}
subgraph cluster3 { style=invis;  n3_0 [label="a"]; n3_1 [label="b"]; n3_2 [label="c"]; n3_3 [label="C"]; n3_4 [label="b"]; n3_5 [label="a"]; {rank=same;n3_0;n3_1;n3_2;n3_3;n3_4;n3_5;}}
subgraph cluster4 { style=invis;  n4_0 [label="a"]; n4_1 [label="b"]; n4_2 [label="c"]; n4_3 [label="b"]; n4_4 [label="a"]; {rank=same;n4_0;n4_1;n4_2;n4_3;n4_4;}}
n0_0 -> n1_0; n0_0 -> n1_1; n0_0 -> n1_2;
n1_0 -> n2_0; n1_1 -> n2_1; n1_1 -> n2_2; n1_1 -> n2_3; n1_2 -> n2_4;
n2_0 -> n3_0; n2_1 -> n3_1; n2_2 -> n3_2; n2_2 -> n3_3; n2_3 -> n3_4; n2_4 -> n3_5;
n3_0 -> n4_0; n3_1 -> n4_1; n3_2 -> n4_2; n3_4 -> n4_3; n3_5 -> n4_4;
// n3_3 is C -> lambda (no terminal child)
}
