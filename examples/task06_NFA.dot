digraph Automaton {
 rankdir=LR; node [shape=circle];
 start [shape=point];
 "k1" [shape=circle];
 "k2" [shape=doublecircle];
 "k3" [shape=circle];
 start -> "k1";
 "k1" -> "k2" [label="0"];
 "k1" -> "k3" [label="0"];
 "k1" -> "k3" [label="x"];
 "k2" -> "k2" [label="x"];
 "k3" -> "k2" [label="0"];
}
